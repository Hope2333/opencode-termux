+/// A2 todo8 (hermetic home): prepend flags from the OPENTUI_C_REMAP env var
+/// (space-separated, e.g. two -ffile-prefix-map entries) to every C/CXX
+/// compile set, so vendored sources (libwebp/lcms2/stb/miniaudio/yoga) bake
+/// remapped assert/__FILE__ paths instead of the build machine's absolute
+/// home path. No-op when the env var is unset.
+fn remapFlags(b: *std.Build, base: []const []const u8) []const []const u8 {
+    const raw = b.graph.environ_map.get("OPENTUI_C_REMAP") orelse return base;
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, raw, ' ');
+    while (it.next()) |_| n += 1;
+    const out = b.allocator.alloc([]const u8, n + base.len) catch @panic("OOM");
+    var i: usize = 0;
+    it.reset();
+    while (it.next()) |tok| : (i += 1) out[i] = tok;
+    @memcpy(out[n..], base);
+    return out;
+}
