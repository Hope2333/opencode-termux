diff --git a/packages/native/src/lib.zig b/packages/native/src/lib.zig
index 8c662de..272b971 100644
--- a/packages/native/src/lib.zig
+++ b/packages/native/src/lib.zig
@@ -9,3 +9,15 @@ comptime {
     _ = @import("runtime-abi.zig");
     _ = @import("yoga.zig");
 }
+
+// bionic 缺少 glibc 专属符号 pthread_tryjoin_np；zig std(linux/glibc 门)对 android
+// 误生成引用，导致 .so 带着未定义符号、dlopen 直接失败。这里导出同名符号自我满足，
+// 与 w7b(0.6.8) 金件同一实现：kill(0) 探测存活 + join 回收已退线程。
+extern "c" fn pthread_kill(t: @import("std").c.pthread_t, sig: c_int) c_int;
+extern "c" fn pthread_join(t: @import("std").c.pthread_t, retval: ?*?*anyopaque) c_int;
+export fn pthread_tryjoin_np(thread: @import("std").c.pthread_t, retval: ?*?*anyopaque) c_int {
+    const r = pthread_kill(thread, 0);
+    if (r == 0) return 16; // EBUSY — 线程仍存活
+    if (r == 3) return pthread_join(thread, retval); // ESRCH — 已退出，join 回收
+    return r;
+}
