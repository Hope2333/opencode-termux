+
+// --- local (android/bionic) addition: translate-c needs the bionic header
+// --- search path explicitly; the global --libc spec is not inherited by
+// --- translate-c steps on zig 0.16. Paths come from the environment so the
+// --- tree stays upstream-clean for everyone else.
+
+var g_libdir: ?[]const u8 = null;
+var g_inc1: ?[]const u8 = null;
+var g_inc2: ?[]const u8 = null;
+
+fn addIncs(inc1: ?[]const u8, inc2: ?[]const u8, step: anytype) void {
+    if (inc1) |p| step.addIncludePath(.{ .cwd_relative = p });
+    if (inc2) |p| step.addIncludePath(.{ .cwd_relative = p });
+}
+
 fn addTranslatedCImports(
     b: *std.Build,
     module: *std.Build.Module,
     optimize: std.builtin.OptimizeMode,
     target: std.Build.ResolvedTarget,
 ) void {
+    // Local (android/bionic) addition: translate-c does not inherit the global
+    // --libc include dirs on zig 0.16, so bionic headers are passed explicitly.
+    // The values live in file-scope globals: this function runs once per target
+    // and b.option panics if the same name is declared twice.
+    const inc1 = g_inc1;
+    const inc2 = g_inc2;
+
     const miniaudio_translate = b.addTranslateC(.{
         .root_source_file = b.path("src/vendor/miniaudio/miniaudio.h"),
         .target = target,
         .optimize = optimize,
     });
     miniaudio_translate.addIncludePath(b.path("src"));
+    addIncs(inc1, inc2, miniaudio_translate);
     module.addImport("miniaudio", miniaudio_translate.createModule());
 
     const yoga_dep = b.dependency("yoga", .{});
