# PKGBUILD for OpenCode Native (transplant revival line) on Termux
# Built via scripts/package/package_pacman_native.sh (pkgver/pkgrel rewritten there).
pkgname=opencode
pkgver=0.0.0
pkgrel=1
pkgdesc='OpenCode native Android runtime for Termux (stable mainline since 27/28, full TUI; glibc appendix is opencode-glibc)'
arch=('aarch64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
options=('!strip' '!debug')

depends=()
# NOTE: no conflict on the literal 'opencode-glibc' name: opencode-glibc-standalone
# provides that virtual name and MUST coexist with us. Mutual exclusion with the
# real glibc package is enforced by its own conflicts=('opencode' ...) list.
conflicts=('opencode-compressed')
replaces=()

source=()
sha256sums=()

# Location of the revived native binary, injected by the packaging script.
: "${OPENCODE_NATIVE_BIN:?OPENCODE_NATIVE_BIN must point to opencode-native-revived}"

package() {
    local prefix="${PREFIX:-/data/data/com.termux/files/usr}"
    if [[ -z "$OPENCODE_NATIVE_BIN" || ! -f "$OPENCODE_NATIVE_BIN" ]]; then
        error "OPENCODE_NATIVE_BIN not set or missing"
        return 1
    fi

    msg "Installing native runtime from $OPENCODE_NATIVE_BIN"
    mkdir -p "$pkgdir$prefix/bin"
    install -m755 "$OPENCODE_NATIVE_BIN" "$pkgdir$prefix/bin/opencode"
}

post_install() {
    echo ""
    echo "OpenCode Native installed (stable mainline since 27/28)"
    echo "Usage: opencode --version"
    echo "Scope: full TUI and run/serve. Stable mainline since 27/28."
    echo "Requires Android API >= 28; zero glibc runtime deps."
    echo "Glibc appendix alternative: package 'opencode-glibc'."
}

post_upgrade() {
    post_install
}
