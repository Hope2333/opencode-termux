# PKGBUILD for OpenCode Native (transplant revival line) on Termux
# Built via scripts/package/package_pacman_native.sh (pkgver/pkgrel rewritten there).
pkgname=opencode
pkgver=0.0.0
pkgrel=1
pkgdesc='OpenCode native Android runtime for Termux (stable mainline since 27/28, full TUI; glibc appendix is opencode-wrapper)'
arch=('aarch64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
options=('!strip' '!debug' '!emptydirs')

depends=()
# NOTE: no conflict on the literal 'opencode-wrapper' name: opencode-wrapper-standalone
# provides that virtual name and MUST coexist with us. Mutual exclusion with the
# real glibc package is enforced by its own conflicts=('opencode' ...) list.
# v1 line installs as opencode1 (bin name + lib dir), v2 as opencode; injected by script.
: "${OPENCODE_BIN_NAME:?OPENCODE_BIN_NAME must be set (opencode1 | opencode)}"
# conflicts/replaces are injected by scripts/package/package_pacman_native.sh per version.
conflicts=('opencode')
replaces=()

source=()
sha256sums=()
install="opencode.install"

# Location of the revived native binary, injected by the packaging script.
: "${OPENCODE_NATIVE_BIN:?OPENCODE_NATIVE_BIN must point to opencode-native-revived}"

package() {
    if [[ -z "$OPENCODE_NATIVE_BIN" || ! -f "$OPENCODE_NATIVE_BIN" ]]; then
        error "OPENCODE_NATIVE_BIN not set or missing"
        return 1
    fi

    msg "Installing native runtime from $OPENCODE_NATIVE_BIN"
    # phase0 absolute convention (2026-10-04): stage under
    # $pkgdir/data/data/com.termux/files/usr/ so tar members are the
    # termux-pacman official absolute form `data/data/com.termux/files/usr/...`
    # (no leading slash; RootDir falls back to /).
    mkdir -p "$pkgdir/data/data/com.termux/files/usr/bin"
    if [[ "$OPENCODE_BIN_NAME" == "opencode1" ]]; then
        # v12.1 layered: bare runtime + XDG-isolating launcher (v2 stays bin-direct)
        install -D -m755 "$OPENCODE_NATIVE_BIN" "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/runtime/opencode"
        install -D -m755 "${REPO_ROOT:?REPO_ROOT must point at the repo root}/scripts/opencode1-launcher.sh" "$pkgdir/data/data/com.termux/files/usr/bin/opencode1"
        # oldkernel-compat follow-up: `.grafted` B 档 marker (launcher graft
        # 探测读它, 老内核机裸跑直起 TUI). sha 必须与打包 runtime 一致 —— 陈旧
        # 标记配非 graft 件直接拒打, 绝不带错标记出货。
        if [[ -n "${OPENCODE_GRAFT_MARKER:-}" && -f "$OPENCODE_GRAFT_MARKER" ]]; then
            local marker_sha bin_sha
            marker_sha="$(sed -n 's/^runtime_sha=//p' "$OPENCODE_GRAFT_MARKER" | head -n1)"
            bin_sha="$(sha256sum "$OPENCODE_NATIVE_BIN" | cut -d' ' -f1)"
            if [[ "$marker_sha" != "$bin_sha" ]]; then
                error ".grafted runtime_sha=$marker_sha != binary sha=$bin_sha — stale marker, refusing to mislabel"
                return 1
            fi
            install -D -m644 "$OPENCODE_GRAFT_MARKER" "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/runtime/.grafted"
            msg "Packaged .grafted marker -> usr/lib/opencode1/runtime/"
        fi
    else
        install -m755 "$OPENCODE_NATIVE_BIN" "$pkgdir/data/data/com.termux/files/usr/bin/$OPENCODE_BIN_NAME"
    fi

    # v12.0: v1 packages ship the migration helper the .INSTALL hook calls
    # (opencode1 only — v2 installs never run the migration branch).
    if [[ "$OPENCODE_BIN_NAME" == "opencode1" ]]; then
        install -m755 "$REPO_ROOT/scripts/migrate-to-opencode1.sh" "$pkgdir/data/data/com.termux/files/usr/bin/migrate-to-opencode1.sh"
        msg "Packaged migrate-to-opencode1.sh (v1 migration helper)"
    fi

    # W11: ship the self-activating seccomp shim when the binary references it
    # (DT_NEEDED libopencode-crhandler.so). It must land in usr/lib/opencode/
    # to satisfy the binary's DT_RUNPATH $ORIGIN/../lib/opencode.
    if grep -aqF libopencode-crhandler.so "$OPENCODE_NATIVE_BIN"; then
        local shim_so
        shim_so="$(dirname "$OPENCODE_NATIVE_BIN")/libopencode-crhandler.so"
        if [[ ! -f "$shim_so" ]]; then
            error "hardened binary references libopencode-crhandler.so but $shim_so is missing (run: make seccomp-harden)"
            return 1
        fi
        # per generation (task-20 forensics): v2 -> usr/lib/opencode (its runtime
        # RUNPATH resolves there); v1 -> usr/lib/opencode1, which the v1 launcher
        # already searches. The two generations no longer write the same file.
        if [[ "${pkgver%%.*}" -lt 2 ]]; then
            shim_dir="$pkgdir/data/data/com.termux/files/usr/lib/opencode1"
        else
            shim_dir="$pkgdir/data/data/com.termux/files/usr/lib/opencode"
        fi
        mkdir -p "$shim_dir"
        install -m644 "$shim_so" "$shim_dir/libopencode-crhandler.so"
        msg "Packaging seccomp shim: $shim_so -> ${shim_dir#$pkgdir/data/data/com.termux/files/}"
    else
        msg "binary is not seccomp-hardened; shipping without libopencode-crhandler.so"
    fi
}

# v12.0: install script (post_install/post_upgrade migration hook)
