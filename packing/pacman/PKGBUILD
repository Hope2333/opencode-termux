pkgname=opencode1-wrapper
pkgver=1.2.10
pkgrel=1
pkgdesc='OpenCode for Termux from local staged prefix (v1 wrapper appendix; renamed opencode1-wrapper)'
arch=('aarch64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
options=('!strip' '!debug' '!emptydirs')
replaces=('opencode1-glibc' 'opencode-wrapper<2.0.0' 'opencode-glibc')
conflicts=('opencode<2.0.0' 'opencode1-compressed' 'opencode1-wrapper-standalone' 'opencode1-native')

makedepends=()
source=()
sha256sums=()

# FIX: use /usr (relative staging) not the full prefix path, so tarball paths
# are usr/bin/opencode1 — v1 bin-direct binary named opencode1 to coexist with v2 opencode on `pacman -U` install.
_repo_root="${REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
_staged_prefix="${STAGED_PREFIX:-${_repo_root}/artifacts/staged/prefix}"

prepare() {
  [[ -x "${_staged_prefix}/lib/opencode/runtime/opencode" ]] || {
    error "missing runtime at ${_staged_prefix}/lib/opencode/runtime/opencode"
    return 1
  }
  [[ -x "${_staged_prefix}/bin/opencode" ]] || {
    error "missing launcher at ${_staged_prefix}/bin/opencode"
    return 1
  }
}

build() {
  true
}

package() {
  # v12.1 layered: wrapper runtime keeps lib/opencode/runtime/ + XDG-isolating launcher
  mkdir -p "$pkgdir/usr/bin" "$pkgdir/usr/lib/opencode/runtime"
  install -D -m755 "${_staged_prefix}/lib/opencode/runtime/opencode" "$pkgdir/usr/lib/opencode/runtime/opencode"
  install -D -m755 "${REPO_ROOT:?REPO_ROOT must point at the repo root}/scripts/opencode1-launcher.sh" "$pkgdir/usr/bin/opencode1"
}
