# PKGBUILD for OpenCode Compressed (UPX-packed native variant) on Termux
# Built via scripts/package/package_pacman_compressed.sh (pkgver/pkgrel rewritten there).
# D1 ruling: mutually exclusive with opencode (native mainline) and
# opencode-wrapper (glibc appendix). Provides the versioned virtual name
# opencode=<pkgver>. No replaces=(): the compressed variant is an
# alternative, not an upgrade - it must never silently displace an
# installed provider or wipe its user data.
pkgname=opencode1-compressed
pkgver=0.0.0
pkgrel=1
# Install script is injected by package_pacman_compressed.sh (install= sed):
# the baked .INSTALL carries the v1 data-isolation hook with a build-time
# MIGRATE_HOOK literal (1 = opencode1 family, 0 = v2 family zero-hook).
# pkgname/pkgver/pkgrel/MIGRATE_HOOK are rewritten there.
# MIGRATE_HOOK also gates the migrate helper install in package() below.
MIGRATE_HOOK=0
# Optional-shim switches, rewritten per build by package_pacman_compressed.sh
# from its OCOMP_SHIMS knob. Defaults below are the historical contract (all
# three shims embedded); a zero-external-.so runtime (e.g. the A2 todo16
# bun-absorb press5 line, which carries its pty inside the bun store chunk and
# uses bun's builtin epoll fallback) is built with OCOMP_SHIMS=none and gets a
# launcher + payload only, with no .so escaping next to the runtime.
SHIP_CR_HANDLER=1
SHIP_PTY=1
SHIP_EPOLL=1
pkgdesc='OpenCode compressed variant for Termux (UPX-packed native bionic runtime, zero glibc)'
arch=('aarch64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
options=('!strip' '!debug' '!emptydirs')

depends=()
provides=("opencode1=$pkgver")
conflicts=('opencode1' 'opencode1-wrapper')
replaces=('opencode-compressed' 'opencode-wrapper-standalone')

source=()
sha256sums=()

# Location of the UPX-packed revived binary, injected by the packaging script.
: "${OPENCODE_COMPRESSED_BIN:?OPENCODE_COMPRESSED_BIN must point to opencode-native-revived-upx}"

package() {
    if [[ -z "$OPENCODE_COMPRESSED_BIN" || ! -f "$OPENCODE_COMPRESSED_BIN" ]]; then
        error "OPENCODE_COMPRESSED_BIN not set or missing"
        return 1
    fi

    msg "Installing compressed runtime from $OPENCODE_COMPRESSED_BIN"
    # phase0 absolute convention (2026-10-04): stage under
    # $pkgdir/data/data/com.termux/files/usr/ so tar members are the
    # termux-pacman official absolute form `data/data/com.termux/files/usr/...`
    # (no leading slash; RootDir falls back to /).
    mkdir -p "$pkgdir/data/data/com.termux/files/usr/bin"
    # v12.1 layered: UPX runtime under lib/opencode1/runtime/ + XDG-isolating launcher
    install -D -m755 "$OPENCODE_COMPRESSED_BIN" "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/runtime/opencode"
    install -D -m755 "${REPO_ROOT:?REPO_ROOT must point at the repo root}/scripts/opencode1-launcher.sh" "$pkgdir/data/data/com.termux/files/usr/bin/opencode1"
    # crhandler shim: REQUIRED whenever SHIP_CR_HANDLER=1 (the DT_NEEDED string
    # is hidden inside the UPX-compressed payload, so the shim ships
    # unconditionally for UPX inputs). Skipped only for a zero-external-.so
    # runtime that declares no DT_NEEDED at all.
    if [[ "$SHIP_CR_HANDLER" == "1" ]]; then
        : "${OPENCODE_CRHANDLER_SO:?OPENCODE_CRHANDLER_SO must point to libopencode-crhandler.so}"
        mkdir -p "$pkgdir/data/data/com.termux/files/usr/lib/opencode1"
        install -m755 "$OPENCODE_CRHANDLER_SO" "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/libopencode-crhandler.so"
    fi
    # pty splice assets (OPTIONAL): patched musl librust_pty + bionic shim from
    # tools/bun-pty-splice/build-splice.sh. Shipped when the packaging script
    # exports OPENCODE_PTY_SPLICE_DIR; the launcher injects BUN_PTY_LIB only
    # when the file exists (backward compatible with splice-less packages).
    if [[ "$SHIP_PTY" == "1" && -n "${OPENCODE_PTY_SPLICE_DIR:-}" ]]; then
        if [[ -f "$OPENCODE_PTY_SPLICE_DIR/librust_pty_arm64_musl_patched.so" && -f "$OPENCODE_PTY_SPLICE_DIR/shim.so" ]]; then
            install -D -m755 "$OPENCODE_PTY_SPLICE_DIR/librust_pty_arm64_musl_patched.so" \
                "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/pty/librust_pty_arm64_musl_patched.so"
            install -D -m755 "$OPENCODE_PTY_SPLICE_DIR/shim.so" \
                "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/pty/shim.so"
            msg "pty splice assets installed under usr/lib/opencode1/pty/"
        else
            warning "OPENCODE_PTY_SPLICE_DIR set but splice files missing — shipping without"
        fi
    fi
    # epoll compat shim (OPTIONAL): bionic LD_PRELOAD shim translating
    # epoll_pwait2(441) -> epoll_pwait for pre-#32490 bun builds. Shipped
    # when the packaging script exports OPENCODE_EPOLL_SHIM_SO; the launcher
    # injects LD_PRELOAD only when the file exists (backward compatible).
    if [[ "$SHIP_EPOLL" == "1" && -n "${OPENCODE_EPOLL_SHIM_SO:-}" ]]; then
        if [[ -f "$OPENCODE_EPOLL_SHIM_SO" ]]; then
            install -m755 "$OPENCODE_EPOLL_SHIM_SO" "$pkgdir/data/data/com.termux/files/usr/lib/opencode1/libepoll-compat.so"
            msg "epoll compat shim installed under usr/lib/opencode1/"
        else
            warning "OPENCODE_EPOLL_SHIM_SO set but shim missing — shipping without"
        fi
    fi
    # v1 migration helper (v1 family only, baked at build time via the
    # .INSTALL MIGRATE_HOOK literal — see opencode1-compressed.install and
    # the packaging script's install= injection): the .INSTALL post_install
    # hook calls it — feature detection first, never a blind migration.
    if [[ "$MIGRATE_HOOK" == "1" ]]; then
        install -m755 "${REPO_ROOT:?REPO_ROOT must point at the repo root}/scripts/migrate-to-opencode1.sh" \
            "$pkgdir/data/data/com.termux/files/usr/bin/migrate-to-opencode1.sh"
        msg "v1 migration helper installed (migrate-to-opencode1.sh)"
    fi
}

post_upgrade() {
    post_install
}
