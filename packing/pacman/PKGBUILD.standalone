pkgname=opencode-wrapper-standalone
pkgver=1.2.10
pkgrel=1
# Single frozen version for rollback only. Coexists with `opencode` (native)
# but mutually exclusive with `opencode-wrapper` (both ship bin/opencode-wrapper).
# No Conflicts against literal `opencode`.
pkgdesc='OpenCode glibc standalone (frozen single-version rollback package)'
arch=('aarch64')
url='https://github.com/anomalyco/opencode'
license=('MIT')
options=('!strip' '!debug')

# Provides the opencode-wrapper virtual name; conflicts with the real
# opencode-wrapper package (both ship bin/opencode-wrapper entry).
provides=('opencode-wrapper')
conflicts=('opencode-wrapper')

# FIX: use /usr (relative staging) not the full prefix path.
_repo_root="${REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
_staged_prefix="${STAGED_PREFIX:-${_repo_root}/artifacts/staged/prefix}"

prepare() {
  [[ -x "${_staged_prefix}/lib/opencode-wrapper/runtime/opencode" ]] || {
    error "missing runtime at ${_staged_prefix}/lib/opencode-wrapper/runtime/opencode"
    return 1
  }
  [[ -x "${_staged_prefix}/bin/opencode-wrapper" ]] || {
    error "missing launcher at ${_staged_prefix}/bin/opencode-wrapper"
    return 1
  }
}

build() {
  true
}

package() {
  mkdir -p "$pkgdir/data/data/com.termux/files/usr"
  cp -a "${_staged_prefix}/." "$pkgdir/data/data/com.termux/files/usr/"
}
